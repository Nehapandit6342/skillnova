generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  password            String
  role                Role                 @default(STUDENT)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  employerProfile     EmployerProfile?
  passwordResetTokens PasswordResetToken[]
  studentProfile      StudentProfile?

  @@map("users")
}

model StudentProfile {
  id                   String          @id @default(uuid()) @db.Uuid
  userId               String          @unique @db.Uuid
  profileImage         String?
  phone                String?
  location             String?
  dateOfBirth          DateTime?
  bio                  String?
  college              String?
  degree               String?
  semester             Int?
  cgpa                 Float?
  careerGoal           String?
  github               String?
  linkedin             String?
  portfolio            String?
  skills               String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  resumeText           String?
  resumeUploadedAt     DateTime?
  resumeUrl            String?
  preferredCompanySize String?
  preferredInternship  String?
  preferredLocation    String?
  workMode             String?
  resumeFileName       String?
  applications         Application[]
  resumeAnalysis       ResumeAnalysis?
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model ResumeAnalysis {
  id                     String         @id @default(uuid()) @db.Uuid
  studentId              String         @unique @db.Uuid
  atsScore               Int
  summary                String
  strengths              Json
  weaknesses             Json
  missingSkills          Json
  recommendedProjects    Json
  recommendedInternships Json
  careerRoadmap          Json
  aiModel                String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  improvementSuggestions Json           @default("[]")
  learningPlan           Json?
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("resume_analysis")
}

model EmployerProfile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @db.Uuid
  logo        String?
  companyName String
  website     String?
  industry    String?
  location    String?
  description String?
  companySize String?
  foundedYear Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isFeatured  Boolean       @default(false)
  status      CompanyStatus @default(PENDING)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  internships Internship[]

  @@map("employer_profiles")
}

model Testimonial {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  designation String
  company     String
  image       String?
  message     String
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model Internship {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  description      String
  location         String?
  type             String?
  stipend          String?
  deadline         DateTime?
  isActive         Boolean          @default(true)
  employerId       String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  requiredSkills   String[]         @default([])
  category         String?
  benefits         String[]         @default([])
  duration         String?
  openings         Int?
  qualifications   String[]         @default([])
  responsibilities String[]         @default([])
  selectionProcess String[]         @default([])
  skills           String[]         @default([])
  workMode         String?
  applicationEmail String?
  applicationLink  String?
  companyOverview  String?
  educationLevel   String?
  experienceLevel  String?
  salaryType       String?
  status           InternshipStatus @default(OPEN)
  applications     Application[]
  employer         EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@map("internships")
}

model Application {
  id           String            @id @default(uuid()) @db.Uuid
  studentId    String            @db.Uuid
  internshipId String            @db.Uuid
  status       ApplicationStatus @default(PENDING)
  availability String?
  coverLetter  String?
  createdAt    DateTime          @default(now())
  phone        String?
  resume       String?
  updatedAt    DateTime          @updatedAt
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, internshipId])
  @@map("applications")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model companies {
  id          String   @id @db.Uuid
  name        String
  logo        String?
  website     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model faqs {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum InternshipStatus {
  OPEN
  PAUSED
  CLOSED
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
