generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  password String

  role Role @default(STUDENT)

  isActive Boolean @default(true)

  studentProfile StudentProfile?

  employerProfile EmployerProfile?

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid


  profileImage String?

  resume String?

  phone String?

  location    String?
  dateOfBirth DateTime?

  bio String?

  college String?

  degree String?

  semester Int?

  cgpa Float?


  careerGoal String?


  github String?

  linkedin String?

  portfolio String?


preferredCompanySize String?
  skills String[] @default([])

  applications Application[]


  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}





model EmployerProfile {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @db.Uuid
  logo        String?
  companyName String
  website     String?
  industry    String?
  location    String?
  description String?
  companySize String?
  foundedYear Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isFeatured  Boolean       @default(false)
  status      CompanyStatus @default(PENDING)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  internships Internship[]

  @@map("employer_profiles")
}





model Internship {
  id String @id @default(uuid()) @db.Uuid

  title String


  description String


  location String?

  type String?


  stipend String?


  deadline DateTime?


  isActive Boolean @default(true)

  employerId String @db.Uuid

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("internships")
}

model Application {
  id String @id @default(uuid()) @db.Uuid

  studentId String @db.Uuid

  internshipId String @db.Uuid



  status String @default("PENDING")



  appliedAt DateTime @default(now())



  student StudentProfile @relation(
    fields: [studentId],
    references: [id],
    onDelete: Cascade
  )


  internship Internship @relation(
    fields: [internshipId],
    references: [id],
    onDelete: Cascade
  )



  @@map("applications")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")

}
// ================= TESTIMONIAL =================

model Testimonial {

  id String @id @default(uuid()) @db.Uuid

  name String

  designation String

  company String

  image String?

  message String

  rating Int @default(5)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("testimonials")
}



// ================= COMPANIES =================

model Company {

  id String @id @default(uuid()) @db.Uuid

  name String

  logo String?

  website String?

  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("companies")
}



// ================= FAQ =================

model FAQ {

  id String @id @default(uuid()) @db.Uuid

  question String

  answer String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("faqs")
}
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
    @@map("notifications")

}