generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum InternshipStatus {
  OPEN
  PAUSED
  CLOSED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name String

  email String @unique

  password String

  role Role @default(STUDENT)

  isActive Boolean @default(true)

  studentProfile StudentProfile?

  employerProfile EmployerProfile?

  notifications Notification[]

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("users")
}

model StudentProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  profileImage String?

  resumeUrl String?

  resumeFileName String?

  resumeText String?

  resumeUploadedAt DateTime?

  phone String?

  location String?

  dateOfBirth DateTime?

  bio String?

  college String?

  degree String?

  semester Int?

  cgpa Float?

  github String?

  linkedin String?

  portfolio String?

  careerGoal String?

  preferredInternship String?

  workMode String?

  preferredLocation String?

  preferredCompanySize String?

  skills String[] @default([])

  applications Application[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  resumeAnalysis ResumeAnalysis?

  @@map("student_profiles")
}

model EmployerProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid

  logo String?

  companyName String

  website String?

  industry String?

  location String?

  description String?

  companySize String?

  foundedYear Int?

  internships Internship[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("employer_profiles")
}

model Internship {
  id String @id @default(uuid()) @db.Uuid

  title String

  description String

  category String?

  companyOverview String?

  experienceLevel String?

  educationLevel String?

  salaryType String?

  applicationEmail String?

  requiredSkills String[] @default([])

  location String?

  type String?

  workMode String?

  duration String?

  stipend String?

  openings Int?

  applicationLink String?

  deadline DateTime?

  responsibilities String[] @default([])

  skills String[] @default([])

  qualifications String[] @default([])

  benefits String[] @default([])

  selectionProcess String[] @default([])

  isActive Boolean @default(true)

  status InternshipStatus @default(OPEN)

  employerId String @db.Uuid

  employer EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("internships")
}

model Application {
  id String @id @default(uuid()) @db.Uuid

  studentId String @db.Uuid

  internshipId String @db.Uuid

  fullName String?

  email String?

  phone String?

  location String?

  college String?

  degree String?

  resume String?

  coverLetter String?

  whyHireMe String?

  availability String?

  expectedDuration String?

  status ApplicationStatus @default(PENDING)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([studentId, internshipId])
  @@index([studentId])
  @@index([internshipId])
  @@index([status])
  @@map("applications")
}

model ResumeAnalysis {
  id String @id @default(uuid()) @db.Uuid

  studentId String @unique @db.Uuid

  atsScore Int

  summary String

  strengths Json

  weaknesses Json

  missingSkills Json

  recommendedProjects Json

  recommendedInternships Json

  careerRoadmap Json

  improvementSuggestions Json @default("[]")

  learningPlan Json?

  aiModel String?

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("resume_analysis")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  otpHash String

  expiresAt DateTime

  used Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  title String

  message String

  type String

  isRead Boolean @default(false)

  link String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
